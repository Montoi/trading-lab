# Run npm run setup:env to create .env with a unique random password.
POSTGRES_PASSWORD=replace-with-generated-secret
APP_PORT=3002
APP_BIND_ADDRESS=127.0.0.1
APP_USERNAME=carlos
APP_PASSWORD=replace-with-a-different-generated-secret
